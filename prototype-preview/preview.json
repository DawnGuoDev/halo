{
  "root": ".",
  "inputs": [
    "src",
    "package.json",
    "package-lock.json",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.cjs",
    "index.html"
  ],
  "checks": [
    [
      "npm",
      "run",
      "build"
    ]
  ],
  "build": [
    "npm",
    "run",
    "build:preview"
  ],
  "entry": "dist/index.html",
  "timeoutSeconds": 240,
  "browser": {
    "ready": ".page-header",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "scenarios": [
      {
        "name": "无筛选时隐藏标签区",
        "suffix": "#/posts",
        "steps": [
          {
            "action": "visible",
            "selector": "[data-testid=post-search-input]"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=active-filters]"
          },
          {
            "action": "visible",
            "selector": "[data-testid=post-list]"
          },
          {
            "action": "count",
            "selector": "[data-testid=post-list] tbody tr",
            "value": 20
          }
        ]
      },
      {
        "name": "筛选显示标签并单独移除",
        "suffix": "#/posts?status=content.halo.run%2Fpublished%3Dfalse&visible=PRIVATE",
        "steps": [
          {
            "action": "text",
            "selector": "[data-testid=active-filters]",
            "text": "状态：未发布"
          },
          {
            "action": "text",
            "selector": "[data-testid=active-filters]",
            "text": "可见性：私有"
          },
          {
            "action": "count",
            "selector": "[data-testid^=filter-tag-]:not([data-testid*=remove])",
            "value": 2
          },
          {
            "action": "click",
            "selector": "[data-testid=filter-tag-remove-visible]"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=filter-tag-visible]"
          },
          {
            "action": "text",
            "selector": "[data-testid=filter-tag-status]",
            "text": "状态：未发布"
          },
          {
            "action": "text",
            "selector": "button[aria-haspopup=listbox]:has-text(\"可见性\")",
            "text": "可见性：全部"
          }
        ]
      },
      {
        "name": "回车搜索生成关键词标签并清除",
        "suffix": "#/posts",
        "steps": [
          {
            "action": "fill",
            "selector": "[data-testid=post-search-input]",
            "value": "Halo"
          },
          {
            "action": "press",
            "selector": "[data-testid=post-search-input]",
            "key": "Enter"
          },
          {
            "action": "text",
            "selector": "[data-testid=filter-tag-keyword]",
            "text": "关键词：Halo"
          },
          {
            "action": "click",
            "selector": "[data-testid=filter-tag-remove-keyword]"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=filter-tag-keyword]"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=post-search-clear]"
          }
        ]
      },
      {
        "name": "清除全部恢复默认",
        "suffix": "#/posts?status=content.halo.run%2Fpublished%3Dfalse&visible=PRIVATE",
        "steps": [
          {
            "action": "click",
            "selector": "[data-testid=clear-all-filters]"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=active-filters]"
          },
          {
            "action": "visible",
            "selector": "[data-testid=post-list]"
          }
        ]
      },
      {
        "name": "筛选变化回到第一页",
        "suffix": "#/posts?page=2",
        "steps": [
          {
            "action": "text",
            "selector": "[data-testid=post-pagination]",
            "text": "2 / 2"
          },
          {
            "action": "click",
            "selector": "button[aria-haspopup=listbox]:has-text(\"状态\")"
          },
          {
            "action": "click",
            "selector": "[role=option]:has-text(\"未发布\")"
          },
          {
            "action": "text",
            "selector": "[data-testid=filter-tag-status]",
            "text": "状态：未发布"
          },
          {
            "action": "text",
            "selector": "[data-testid=post-pagination]",
            "text": "1 / 1"
          },
          {
            "action": "text",
            "selector": "[data-testid=active-filters]",
            "text": "清除全部"
          }
        ]
      },
      {
        "name": "筛选无结果清除筛选",
        "suffix": "#/posts?category=tag-%E4%B8%8D%E5%AD%98%E5%9C%A8&tag=tag-%E4%B8%8D%E5%AD%98%E5%9C%A8",
        "steps": [
          {
            "action": "text",
            "selector": ".empty-title",
            "text": "没有符合筛选条件的文章"
          },
          {
            "action": "count",
            "selector": "[data-testid=empty-clear-filters]",
            "value": 1
          },
          {
            "action": "click",
            "selector": "[data-testid=empty-clear-filters]"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=active-filters]"
          },
          {
            "action": "visible",
            "selector": "[data-testid=post-list]"
          }
        ]
      },
      {
        "name": "站点无文章保留原空态",
        "suffix": "?scenario=empty#/posts",
        "steps": [
          {
            "action": "text",
            "selector": ".empty-title",
            "text": "当前没有文章"
          },
          {
            "action": "count",
            "selector": "[data-testid=empty-clear-filters]",
            "value": 0
          },
          {
            "action": "text",
            "selector": ".empty-actions",
            "text": "新建"
          }
        ]
      },
      {
        "name": "速览抽屉展示文章信息",
        "suffix": "#/posts",
        "steps": [
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-01]"
          },
          {
            "action": "visible",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "欢迎使用 Halo：五分钟完成站点搭建",
            "exact": true
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-status]",
            "text": "已发布"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-visible]",
            "text": "公开"
          },
          {
            "action": "count",
            "selector": "[data-testid=quick-view-categories] .tag-wrapper",
            "value": 2
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-categories]",
            "text": "默认分类"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-tags]",
            "text": "入门"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-tags]",
            "text": "部署"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-publish-time]",
            "text": "2026-11-15 00:12"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-update-time]",
            "text": "2026-11-16 07:25"
          },
          {
            "action": "visible",
            "selector": "[data-testid=quick-view-edit]"
          }
        ]
      },
      {
        "name": "空分类标签与未发布占位",
        "suffix": "#/posts",
        "steps": [
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-04]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "从 1.x 迁移到 2.x 的注意事项",
            "exact": true
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-categories-empty]",
            "text": "未设置分类"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-publish-time-empty]",
            "text": "未发布"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-tags]",
            "text": "发布"
          }
        ]
      },
      {
        "name": "无标签也显示占位",
        "suffix": "#/posts",
        "steps": [
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-07]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "标签与分类的组织方式",
            "exact": true
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-categories-empty]",
            "text": "未设置分类"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-tags-empty]",
            "text": "未设置标签"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-status]",
            "text": "已发布"
          }
        ]
      },
      {
        "name": "定时发布与发布中状态",
        "suffix": "#/posts?sort=status.lastModifyTime,desc",
        "steps": [
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-12]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-status]",
            "text": "定时发布"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-publish-time]",
            "text": "2026-11-04 19:49"
          }
        ]
      },
      {
        "name": "连续查看与Esc保持筛选页码",
        "suffix": "#/posts?visible=PRIVATE",
        "steps": [
          {
            "action": "text",
            "selector": "[data-testid=filter-tag-visible]",
            "text": "可见性：私有"
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-10]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "为文章添加自定义模板",
            "exact": true
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-visible]",
            "text": "私有"
          },
          {
            "action": "press",
            "selector": "[data-testid=quick-view-drawer]",
            "key": "Escape"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "text",
            "selector": "[data-testid=filter-tag-visible]",
            "text": "可见性：私有"
          },
          {
            "action": "count",
            "selector": "[data-testid=post-list] tbody tr",
            "value": 8
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-30]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "编写可维护的主题样式",
            "exact": true
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-categories]",
            "text": "文档"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-publish-time]",
            "text": "2025-12-05 10:35"
          },
          {
            "action": "press",
            "selector": "[data-testid=quick-view-drawer]",
            "key": "Escape"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "text",
            "selector": "[data-testid=filter-tag-visible]",
            "text": "可见性：私有"
          },
          {
            "action": "count",
            "selector": "[data-testid=post-list] tbody tr",
            "value": 8
          }
        ]
      },
      {
        "name": "编辑文章后返回保持页码关闭抽屉",
        "suffix": "#/posts?page=2&size=30",
        "steps": [
          {
            "action": "text",
            "selector": "[data-testid=post-pagination]",
            "text": "2 / 2"
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-32]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "自定义归档页面模板",
            "exact": true
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-edit]"
          },
          {
            "action": "visible",
            "selector": "[data-testid=post-editor-placeholder]"
          },
          {
            "action": "text",
            "selector": "[data-testid=editor-post-title]",
            "text": "自定义归档页面模板",
            "exact": true
          },
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "click",
            "selector": "[data-testid=editor-back]"
          },
          {
            "action": "visible",
            "selector": "[data-testid=post-list]"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "text",
            "selector": "[data-testid=post-pagination]",
            "text": "2 / 2"
          },
          {
            "action": "text",
            "selector": "[data-testid=post-pagination]",
            "text": "共 40 项数据"
          },
          {
            "action": "text",
            "selector": "[data-testid=post-row-post-32]",
            "text": "自定义归档页面模板"
          }
        ]
      },
      {
        "name": "速览入口始终可见（⋯左侧）",
        "suffix": "#/posts",
        "steps": [
          {
            "action": "visible",
            "selector": "[data-testid=quick-view-post-01]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-post-01]",
            "text": "速览"
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-01]"
          },
          {
            "action": "visible",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "欢迎使用 Halo：五分钟完成站点搭建",
            "exact": true
          }
        ]
      },
      {
        "name": "点击遮罩不关闭且关闭按钮关闭保留页码",
        "suffix": "#/posts?page=2&size=30",
        "steps": [
          {
            "action": "text",
            "selector": "[data-testid=post-pagination]",
            "text": "2 / 2"
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-35]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "评论审核与反垃圾策略",
            "exact": true
          },
          {
            "action": "click",
            "selector": ".modal-wrapper.quick-view-drawer .modal-layer"
          },
          {
            "action": "visible",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "评论审核与反垃圾策略",
            "exact": true
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-drawer] .modal-header-actions > span"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "text",
            "selector": "[data-testid=post-pagination]",
            "text": "2 / 2"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-post-35]",
            "text": "速览"
          }
        ]
      },
      {
        "name": "连续切换不同文章不残留上一篇",
        "suffix": "#/posts",
        "steps": [
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-01]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-categories]",
            "text": "默认分类"
          },
          {
            "action": "press",
            "selector": "[data-testid=quick-view-drawer]",
            "key": "Escape"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-04]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "从 1.x 迁移到 2.x 的注意事项",
            "exact": true
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-categories-empty]",
            "text": "未设置分类"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-publish-time-empty]",
            "text": "未发布"
          },
          {
            "action": "press",
            "selector": "[data-testid=quick-view-drawer]",
            "key": "Escape"
          },
          {
            "action": "hidden",
            "selector": "[data-testid=quick-view-drawer]"
          },
          {
            "action": "click",
            "selector": "[data-testid=quick-view-post-07]"
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-title]",
            "text": "标签与分类的组织方式",
            "exact": true
          },
          {
            "action": "text",
            "selector": "[data-testid=quick-view-tags-empty]",
            "text": "未设置标签"
          },
          {
            "action": "count",
            "selector": "[data-testid=quick-view-drawer]",
            "value": 1
          }
        ]
      }
    ]
  },
  "delivery": [
    "src",
    "package.json",
    "package-lock.json",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.cjs",
    "tsconfig.json",
    "tsconfig.app.json",
    "env.d.ts",
    "index.html",
    "public",
    "preview.json",
    "scripts",
    "dist",
    "README.md",
    "integration-guide.md",
    "prototype-map.json",
    "design-notes.md",
    "screenshot-filters-active.png",
    "screenshot-keyword-active.png",
    "screenshot-filtered-empty.png",
    "screenshot-quick-view-entry.png",
    "screenshot-quick-view-drawer.png",
    "screenshot-quick-view-empty.png",
    "screenshot-quick-view-list-with-filters.png",
    "screenshot-quick-view-page2-drawer.png",
    "screenshot-quick-view-switch-no-residue.png",
    "screenshot-editor-placeholder.png"
  ],
  "serveRoot": "dist",
  "deliveryRoles": {
    "source": [
      "src"
    ],
    "build": [
      "package.json",
      "package-lock.json",
      "vite.config.ts",
      "tailwind.config.ts",
      "postcss.config.cjs",
      "tsconfig.json",
      "tsconfig.app.json",
      "env.d.ts",
      "index.html",
      "public"
    ],
    "guide": [
      "README.md",
      "integration-guide.md",
      "prototype-map.json",
      "design-notes.md",
      "screenshot-filters-active.png",
      "screenshot-keyword-active.png",
      "screenshot-filtered-empty.png",
      "screenshot-quick-view-entry.png",
      "screenshot-quick-view-drawer.png",
      "screenshot-quick-view-empty.png",
      "screenshot-quick-view-list-with-filters.png",
      "screenshot-quick-view-page2-drawer.png",
