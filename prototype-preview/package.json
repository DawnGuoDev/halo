{
  "name": "halo-console-prototype-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Halo 控制台独立原型工程（预览用，不依赖后端）",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "build:preview": "vite build",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@halo-dev/components": "2.27.0",
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^13.0.0",
    "vue": "^3.5.41",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.7.0",
    "sass": "^1.80.0",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  }
}
