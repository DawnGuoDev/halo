# Copy to e2e.local.env (git-ignored) or export the variables before running.
# Never commit real passwords.

# Base URL of a running Halo instance. When empty the harness boots one via Gradle.
HALO_E2E_BASE_URL=
# Console locale written to localStorage. zh-CN keeps the copy assertions in this suite aligned.
HALO_E2E_CONSOLE_LOCALE=zh-CN
# Playwright channel: chrome (system Chrome) by default. Use chromium for a managed build.
HALO_E2E_CHANNEL=chrome

# Startup only
HALO_E2E_PORT=8090
HALO_E2E_RUNTIME_DIR=
HALO_E2E_BOOT_TIMEOUT_MS=180000
HALO_E2E_JAVA_OPTS=
HALO_E2E_EXTERNAL_URL=

# Contract checks against generated artifacts (file paths relative to the repo root)
HALO_E2E_OPENAPI_CONSOLE=api-docs/openapi/v3_0/apis_console.api_v1alpha1.json
HALO_E2E_OPENAPI_UC=api-docs/openapi/v3_0/apis_uc.api_v1alpha1.json
