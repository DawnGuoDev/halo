{
  "schemaVersion": 1,
  "root": "../..",
  "app": "ui",
  "inputs": [
    "ui/package.json",
    "ui/pnpm-lock.yaml",
    "ui/pnpm-workspace.yaml",
    "scripts/prototype/environment.py",
    "scripts/prototype/probe-node.mjs",
    "scripts/prototype/setup.sh",
    ".prototype/ui/toolchain.json",
    "scripts/prototype/runtime.py",
    "scripts/prototype/ui.sh",
    "scripts/prototype/preflight.py"
  ],
  "probes": [
    [
      "python3",
      "../scripts/prototype/runtime.py",
      "versions"
    ]
  ],
  "install": [
    "bash",
    "../scripts/prototype/ui.sh",
    "install",
    "--frozen-lockfile"
  ],
  "env": {
    "CI": "true",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "note": "Run setup.sh from any cwd to prepare verified tools first. Runner commands execute in ui/. Install calls only the pnpm leaf driver, never setup.sh. --check is read-only and does not install dependencies."
}
